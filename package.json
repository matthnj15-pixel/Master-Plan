{
  "name": "master-plan",
  "version": "0.6.0-dev",
  "private": true,
  "description": "Turn-based small-town planning sim: you author the plan, the town grows in response.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs && node scripts/trace.mjs",
    "test:core": "node --test tests/engine.test.mjs tests/build.test.mjs && node scripts/trace.mjs",
    "trace": "node scripts/trace.mjs --report"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
